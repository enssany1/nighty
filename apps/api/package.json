{
  "name": "@nighty/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "jest --runInBand --testPathIgnorePatterns=/test/",
    "test:integration": "jest --runInBand --testPathPatterns=test/",
    "prisma:generate": "cross-env DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build prisma generate --config prisma7.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "prisma:setup:test": "prisma migrate deploy --config prisma7.config.ts && prisma db seed --config prisma7.config.ts",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.9",
    "@swc/core": "^1.15.3",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
