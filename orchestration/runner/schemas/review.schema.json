{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nighty.review/v1",
  "type": "object",
  "required": ["schema", "task_id", "task_revision", "attempt", "run_id", "decision", "reviewed_by", "created_at", "delivery_sha256", "baseline_commit", "head_commit", "branch", "source_sha256", "tree_sha256", "task_sha256", "mandatory_criteria_verified", "sections", "section_content"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "nighty.review/v1" },
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]{3}$" },
    "task_revision": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "string", "pattern": "^A[0-9]{2}$" },
    "run_id": { "type": "string", "format": "uuid" },
    "decision": { "enum": ["APPROVED", "CHANGES_REQUIRED", "BLOCKED"] },
    "reviewed_by": { "const": "codex" },
    "created_at": { "type": "string", "format": "date-time" },
    "delivery_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "head_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
    "source_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "tree_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "task_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "mandatory_criteria_verified": { "type": "boolean" },
    "sections": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "section_content": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
