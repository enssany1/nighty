{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nighty.delivery/v1",
  "type": "object",
  "required": ["schema", "task_id", "task_revision", "attempt", "run_id", "status", "baseline_commit", "delivered_commit", "created_by", "created_at", "sections", "section_content"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "nighty.delivery/v1" },
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]{3}$" },
    "task_revision": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "string", "pattern": "^A[0-9]{2}$" },
    "run_id": { "type": "string", "format": "uuid" },
    "status": { "const": "DELIVERED" },
    "baseline_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{7,40}|NOT_INITIALIZED)$" },
    "delivered_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{7,40}|UNCOMMITTED)$" },
    "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
    "created_by": { "const": "deepseek" },
    "created_at": { "type": "string", "format": "date-time" },
    "sections": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "section_content": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "changed_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
