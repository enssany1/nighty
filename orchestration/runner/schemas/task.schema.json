{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nighty.task/v1",
  "type": "object",
  "required": ["schema", "task_id", "revision", "status", "priority", "depends_on", "requirements", "created_by", "created_at"],
  "properties": {
    "schema": { "const": "nighty.task/v1" },
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]{3}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "const": "READY_FOR_DEVELOPMENT" },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[0-9]{3}$" }, "uniqueItems": true },
    "requirements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "created_by": { "const": "codex" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
