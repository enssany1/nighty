  "info": {
    "title": "Nighty API",
    "description": "Shift Operations Handover API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nighty_session"
      }
    },
    "schemas": {
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "aisha"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "writeOnly": true
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "OPERATOR"
            ]
          },
          "csrfToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "displayName",
          "role",
          "csrfToken",
          "expiresAt"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "OPERATOR"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "shiftIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "mustChangePassword": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "role",
          "status",
          "shiftIds",
          "mustChangePassword"
        ]
      },
      "CreateUserRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "OPERATOR"
            ]
          },
          "shiftIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "username",
          "displayName",
          "role",
          "shiftIds"
        ]
      },
      "ShiftDefinitionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "startMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1439
          },
          "endMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1439
          },
          "position": {
            "type": "number",
            "minimum": 1
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "startMinute",
          "endMinute",
          "position",
          "active"
        ]
      },
      "SaveShiftDefinitionRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "startMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1439
          },
          "endMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1439
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "startMinute",
          "endMinute",
          "active"
        ]
      },
      "TodoItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "position": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "text",
          "position"
        ]
      },
      "EntryResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "UPDATE",
              "TODO",
              "FOLLOW"
            ]
          },
          "editorDocument": {
            "type": "object",
            "additionalProperties": true
          },
          "plainText": {
            "type": "string"
          },
          "followStatus": {
            "type": "string",
            "enum": [
              "OPEN",
              "COMPLETED"
            ]
          },
          "todoItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TodoItemDto"
            }
          },
          "authorId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "type",
          "editorDocument",
          "plainText",
          "todoItems",
          "authorId",
          "createdAt"
        ]
      },
      "CreateEntryRequestDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "UPDATE",
              "TODO",
              "FOLLOW"
            ]
          },
          "editorDocument": {
            "type": "object",
            "additionalProperties": true
          },
          "plainText": {
            "type": "string"
          },
          "todoItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TodoItemDto"
            }
          },
          "tagIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "type",
          "editorDocument",
          "plainText"
        ]
      },
      "ShiftCanvasDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "UPCOMING",
              "ACTIVE",
              "CLOSED"
            ]
          },
          "writable": {
            "type": "boolean"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntryResponseDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "writable",
          "entries"
        ]
      },
      "CanvasResponseDto": {
        "type": "object",
        "properties": {
          "operationalDayId": {
            "type": "string",
            "format": "uuid"
          },
          "operationalDate": {
            "type": "string",
            "format": "date"
          },
          "shifts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShiftCanvasDto"
            }
          }
        },
        "required": [
          "operationalDayId",
          "operationalDate",
          "shifts"
        ]
      },
      "HandoverResponseDto": {
        "type": "object",
        "properties": {
          "closedShiftId": {
            "type": "string",
            "format": "uuid"
          },
          "openedShiftId": {
            "type": "string",
            "format": "uuid"
          },
          "transferredFollowCount": {
            "type": "number",
            "minimum": 0
          },
          "alreadyCompleted": {
            "type": "boolean"
          }
        },
        "required": [
          "closedShiftId",
          "openedShiftId",
          "transferredFollowCount",
          "alreadyCompleted"
        ]
      },
      "TagResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "number",
            "minimum": 1
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "position",
          "archived"
        ]
      },
      "SaveTagRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "AttachmentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "originalName": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "byteSize": {
            "type": "number",
            "minimum": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "INLINE",
              "ATTACHMENT"
            ]
          },
          "downloadUrl": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "originalName",
          "mimeType",
          "byteSize",
          "disposition",
          "downloadUrl"
        ]
      },
      "SearchResultDto": {
        "type": "object",
        "properties": {
          "entryId": {
            "type": "string",
            "format": "uuid"
          },
          "operationalDate": {
            "type": "string",
            "format": "date"
          },
          "shiftName": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "UPDATE",
              "TODO",
              "FOLLOW"
            ]
          },
          "plainText": {
            "type": "string"
          }
        },
        "required": [
          "entryId",
          "operationalDate",
          "shiftName",
          "type",
          "plainText"
        ]
      },
      "SearchResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResultDto"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ]
      },
      "SettingResponseDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "object",
            "additionalProperties": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "key",
          "value",
          "updatedAt"
        ]
      },
      "AuditEventResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "actorUserId": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "entityType": {
            "type": "string"
          },
          "entityId": {
            "type": "string"
          },
          "before": {
            "type": "object",
            "additionalProperties": true
          },
          "after": {
            "type": "object",
            "additionalProperties": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "action",
          "entityType",
          "entityId",
          "createdAt"
        ]
      }
    }
  }
}
