  "info": {
    "title": "Nighty API",
    "description": "Shift Operations Handover API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nighty_session"
      }
    },
    "schemas": {
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "aisha"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "writeOnly": true
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "ChangePasswordRequestDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 8,
            "writeOnly": true
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "writeOnly": true
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "OPERATOR"
            ]
          },
          "csrfToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "displayName",
          "role",
          "csrfToken",
          "expiresAt"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "OPERATOR"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "shiftIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "mustChangePassword": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "role",
          "status",
          "shiftIds",
          "mustChangePassword"
        ]
      },
      "CreateUserRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "OPERATOR"
            ]
          },
          "shiftIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "username",
          "displayName",
          "role",
          "shiftIds"
        ]
      },
      "UpdateUserRequestDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "OPERATOR"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "shiftIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "UpdateProfileRequestDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "displayName"
        ]
      },
      "TemporaryPasswordResponseDto": {
        "type": "object",
        "properties": {
          "temporaryPassword": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "temporaryPassword"
        ]
      },
      "ShiftDefinitionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "startMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1439
          },
          "endMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1439
          },
          "position": {
            "type": "number",
            "minimum": 1
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "startMinute",
          "endMinute",
          "position",
          "active"
        ]
      },
      "SaveShiftDefinitionRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "startMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1439
          },
          "endMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1439
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "startMinute",
          "endMinute",
          "active"
        ]
      },
      "ReorderShiftsRequestDto": {
        "type": "object",
        "properties": {
          "shiftIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "shiftIds"
        ]
      },
      "TodoItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "position": {
            "type": "number",
